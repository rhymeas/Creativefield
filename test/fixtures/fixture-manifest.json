{
  "id": "fixture-i2v",
  "family": "fixture",
  "label": "Fixture (test only)",
  "modes": [
    "image_to_video"
  ],
  "inputs": {
    "prompt": {
      "node": "1",
      "field": "text"
    },
    "negative": {
      "node": "2",
      "field": "text"
    },
    "start_image": {
      "node": "4",
      "field": "image"
    },
    "width": {
      "node": "5",
      "field": "width"
    },
    "height": {
      "node": "5",
      "field": "height"
    },
    "length": {
      "node": "5",
      "field": "length",
      "map": "seconds_to_wan_frames"
    },
    "seed": {
      "node": "3",
      "field": "seed"
    }
  },
  "outputs": {
    "video": {
      "node": "6"
    }
  },
  "limits": {
    "minDurationSec": 1,
    "maxDurationSec": 5,
    "fps": 16,
    "resolutions": {
      "landscape": {
        "width": 832,
        "height": 480
      },
      "portrait": {
        "width": 480,
        "height": 832
      }
    }
  },
  "display": {
    "title": "Fixture",
    "subtitle": "Test only",
    "short": "Fixture",
    "resolution": "480p"
  }
}
