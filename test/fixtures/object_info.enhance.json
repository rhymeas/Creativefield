 },
 "LoadVideo": {
  "input": {
   "required": {
    "file": [
     "COMBO",
     {
      "multiselect": false,
      "options": [
       "studio-enhance-probe.mp4",
       "studio-mvbhuc8t-c70eef-clip-67ca843e.mp4"
      ],
      "video_upload": true
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "file"
   ]
  },
  "output": [
   "VIDEO"
  ],
  "name": "LoadVideo"
 },
