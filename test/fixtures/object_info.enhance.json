{
 "CreateVideo": {
  "input": {
   "required": {
    "images": [
     "IMAGE",
     {
      "tooltip": "The images to create a video from."
     }
    ],
    "fps": [
     "FLOAT",
     {
      "default": 30.0,
      "min": 1.0,
      "max": 120.0,
      "step": 1.0
     }
    ]
   },
   "optional": {
    "audio": [
     "AUDIO",
     {
      "tooltip": "The audio to add to the video."
     }
    ],
    "bit_depth": [
     "COMBO",
     {
      "tooltip": "Auto uses 8-bit for sRGB and 10-bit for HDR. Explicit 8-bit and 10-bit choices are independent of colorspace.",
      "default": "auto",
      "multiselect": false,
      "options": [
       "auto",
       8,
       10
      ]
     }
    ],
    "color_space": [
     "COMBO",
     {
      "tooltip": "Colorspace of the input images. HDR selects BT.2020/HLG and HDR PQ selects BT.2020/PQ.",
      "default": "sRGB",
      "multiselect": false,
      "options": [
       "sRGB",
       "HDR",
       "HDR PQ"
      ]
     }
    ],
    "codec": [
     "COMBO",
     {
      "tooltip": "Optionally encode the video immediately. None keeps the images in tensor form; Auto uses H.264.",
      "advanced": true,
      "default": "none",
      "multiselect": false,
      "options": [
       "none",
       "auto",
       "h264"
      ]
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "images",
    "fps"
   ],
   "optional": [
    "audio",
    "bit_depth",
    "color_space",
    "codec"
   ]
  },
  "output": [
   "VIDEO"
  ],
  "name": "CreateVideo"
 },
 "GetVideoComponents": {
  "input": {
   "required": {
    "video": [
     "VIDEO",
     {
      "tooltip": "The video to extract components from."
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "video"
   ]
  },
  "output": [
   "IMAGE",
   "AUDIO",
   "FLOAT",
   "COMBO",
   "COMBO"
  ],
  "name": "GetVideoComponents"
 },
 "ImageScaleBy": {
  "input": {
   "required": {
    "image": [
     "IMAGE"
    ],
    "upscale_method": [
     [
      "nearest-exact",
      "bilinear",
      "area"
     ]
    ],
    "scale_by": [
     "FLOAT",
     {
      "default": 1.0,
      "min": 0.01,
      "max": 8.0,
      "step": 0.01
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "image",
    "upscale_method",
    "scale_by"
   ]
  },
  "output": [
   "IMAGE"
  ],
  "name": "ImageScaleBy"
 },
 "ImageUpscaleWithModel": {
  "input": {
   "required": {
