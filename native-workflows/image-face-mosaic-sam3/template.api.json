{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    },
    "_meta": {
      "title": "Picture"
    }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": {
      "title": "SAM 3.1"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "face",
      "clip": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "What to pixelate (text)"
    }
  },
  "4": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ],
      "conditioning": [
        "3",
        0
      ],
      "threshold": 0.4,
      "refine_iterations": 2,
      "individual_masks": false
    },
    "_meta": {
      "title": "SAM 3.1: every face, one mask"
    }
  },
  "5": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "4",
        0
      ],
      "expand": 12,
      "tapered_corners": true
    },
    "_meta": {
      "title": "Grow the mask (hair line, jaw)"
    }
  },
  "6": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "1",
        0
      ]
    },
    "_meta": {}
  },
  "7": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "area",
      "scale_by": 0.04
    },
    "_meta": {
      "title": "Down to blocks (each block averages its pixels)"
    }
  },
  "8": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "7",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": [
        "6",
        0
      ],
      "height": [
        "6",
        1
      ],
      "crop": "disabled"
    },
    "_meta": {
      "title": "Back up, hard edges"
    }
  },
  "9": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "1",
        0
      ],
      "source": [
        "8",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Mosaic only under the mask"
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "filename_prefix": "ComfyField/image-face-mosaic-sam3"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
