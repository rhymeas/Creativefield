{
  "schemaVersion": 2,
  "id": "flux2-klein-preserve-edit",
  "version": "0.2.0",
  "title": "Fibo 2.0 precision edit",
  "category": "canvas",
  "description": "Experimental localized still edit using unmodified upstream Crop & Stitch and Klein Edit Composite. Manual aligned mask; original, candidate, effective mask and final are retained.",
  "inputs": [
    {
      "id": "source_image",
      "label": "Original image",
      "type": "image",
      "required": true,
      "binding": {
        "node": "76",
        "field": "image"
      }
    },
    {
      "id": "edit_mask",
      "label": "Aligned edit mask",
      "type": "mask",
      "representation": "image",
      "required": true,
      "binding": {
        "node": "477",
        "field": "image"
      }
    }
  ],
  "outputs": [
    {
      "id": "edited_image",
      "label": "Preserved image",
      "type": "image",
      "required": true
    },
    {
      "id": "candidate_image",
      "label": "Crop-and-stitch candidate",
      "type": "image",
      "required": true
    },
    {
      "id": "effective_mask",
      "label": "Effective Klein mask",
      "type": "mask",
      "representation": "image",
      "required": true
    }
  ],
  "controls": [
    {
      "id": "prompt",
      "label": "Edit prompt",
      "type": "string",
      "default": "Change the background to a snowy mountain at dusk, keep the foreground unchanged",
      "binding": {
        "node": "93",
        "field": "prompt"
      }
    },
    {
      "id": "steps",
      "label": "Steps",
      "type": "integer",
      "min": 2,
      "max": 12,
      "default": 4,
      "binding": {
        "node": "94",
        "field": "steps"
      }
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "integer",
      "min": 0,
      "max": 2147483647,
      "default": 20261019,
      "binding": {
        "node": "94",
        "field": "seed"
      }
    },
    {
      "id": "mask_mode",
      "label": "Mask mode",
      "type": "select",
      "options": [
        "replace",
        "add",
        "subtract"
      ],
      "default": "replace",
      "binding": {
        "node": "484",
        "field": "custom_mask_mode"
      }
    },
    {
      "id": "feather_pct",
      "label": "Feather (% diagonal)",
      "type": "number",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "default": 0.5,
      "binding": {
        "node": "484",
        "field": "feather_pct"
      }
    },
    {
      "id": "context_pixels",
      "label": "Context pixels",
      "type": "integer",
      "min": 0,
      "max": 512,
      "default": 32,
      "binding": {
        "node": "482",
        "field": "context_expand_pixels"
      }
    },
    {
      "id": "mask_grow",
      "label": "Mask grow (pixels)",
      "type": "integer",
      "min": 0,
      "max": 16,
      "default": 8,
      "binding": {
        "node": "489",
        "field": "expand"
      }
    },
    {
      "id": "seamless_edges",
      "label": "Seamless edges",
      "type": "boolean",
      "default": false,
      "binding": {
        "node": "484",
        "field": "poisson_blend_edges"
      }
    }
  ],
