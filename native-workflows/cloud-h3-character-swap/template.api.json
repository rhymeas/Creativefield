{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "comfyfield-source.mp4"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "comfyfield-character.png"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["1", 0]
    }
  },
  "4": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax"
    }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "7": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "8": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["5", 0],
      "vae": ["6", 0],
      "audio_vae": ["7", 0],
      "prompt": "Use <Video 1> as the movement and the camera, and <Picture 1> as the character. Replace the person in the video with that character: same face, hair and clothes. Keep the background, the light and everyone else as they are.",
      "width": 768,
      "height": 1344,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["2", 0],
      "ref_videos.ref_video_0": ["3", 0]
    }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "10": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1
    }
  },
  "11": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["4", 0],
      "conditioning": ["8", 0]
    }
  },
  "12": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["4", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    }
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["10", 0],
      "guider": ["11", 0],
      "sampler": ["9", 0],
      "sigmas": ["12", 0],
      "latent_image": ["8", 1]
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["13", 0],
      "vae": ["6", 0]
    }
  },
  "15": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["13", 0],
      "vae": ["7", 0]
    }
  },
  "16": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["14", 0],
      "audio": ["15", 0],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "17": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["16", 0],
      "filename_prefix": "ComfyField/cloud-h3-character-swap",
      "format": "auto",
      "format.codec": "auto"
    }
  }
}
