{
  "schemaVersion": 2,
  "id": "fibo2-edit",
  "version": "0.1.0",
  "title": "Fibo 2.0 image edit",
  "category": "image",
  "description": "Change a picture by saying what to change; everything else stays. Fibo 2.0 Edit Turbo ranks first among open image editors. Add up to three reference pictures for the look of the change. Runs on this computer in 4 steps.",
  "inputs": [
    {
      "id": "source_image",
      "label": "Image to edit",
      "type": "image",
      "required": true,
      "binding": {
        "node": "10",
        "field": "image"
      }
    },
    {
      "id": "reference_image",
      "label": "Reference image (optional)",
      "type": "image",
      "required": false,
      "omitWhenMissing": true,
      "binding": {
        "node": "30",
        "field": "image"
      }
    },
    {
      "id": "reference_image_2",
      "label": "Second reference (optional)",
      "type": "image",
      "required": false,
      "omitWhenMissing": true,
      "binding": {
        "node": "31",
        "field": "image"
      }
    },
    {
      "id": "reference_image_3",
      "label": "Third reference (optional)",
      "type": "image",
      "required": false,
      "omitWhenMissing": true,
      "binding": {
        "node": "32",
        "field": "image"
      }
    }
  ],
  "outputs": [
    {
      "id": "image",
      "label": "Edited image",
      "type": "image",
      "required": true
    }
  ],
  "controls": [
    {
      "id": "megapixels",
      "label": "Size",
      "type": "select",
      "options": [1, 2, 4],
      "default": 1,
      "sizeChoice": true,
      "binding": {"node":"4","field":"width"}
    },
    {
      "id": "prompt",
      "label": "Prompt",
      "type": "string",
      "default": "",
      "binding": {
        "node": "13",
        "field": "value"
      }
    },
    {
      "id": "improve_prompt",
      "label": "Improve my prompt",
      "type": "boolean",
      "default": true,
      "binding": {
        "node": "15",
        "field": "switch"
      }
    },
    {
      "id": "steps",
      "label": "Steps",
      "type": "integer",
      "min": 2,
      "max": 12,
      "default": 4,
      "binding": {
        "node": "5",
        "field": "steps"
      }
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "integer",
      "min": 0,
      "max": 2147483647,
      "default": 1234,
      "binding": {
        "node": "5",
        "field": "seed"
      },
      "alsoBindings": [
        {
          "node": "14",
          "field": "sampling_mode.seed"
        }
      ]
    }
  ],
