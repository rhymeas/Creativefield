{
  "schemaVersion": 2,
  "id": "flux2-klein-edit",
  "version": "2.0.0",
  "title": "FLUX 3 Klein image edit",
  "category": "image",
  "description": "Local single-image edit with the installed FLUX 3 Klein FP8 model. The source image is scaled to roughly one megapixel and used as a reference latent while the prompt describes the change. The exact graph has produced a verified 1024x1024 PNG on the qualified local ComfyUI 0.37.0 worker.",
  "inputs": [
    {
      "id": "source_image",
      "label": "Source image",
      "type": "image",
      "required": true,
      "binding": {
        "node": "133",
        "field": "image"
      }
    }
  ],
  "outputs": [
    {
      "id": "image",
      "label": "Edited image",
      "type": "image",
      "required": true
    }
  ],
  "controls": [
    {
      "id": "prompt",
      "label": "Edit prompt",
      "type": "string",
      "default": "Change the background to a snowy mountain at dusk, keep the foreground unchanged",
      "binding": {
        "node": "28",
        "field": "value"
      }
    },
    {
      "id": "megapixels",
      "label": "Size (megapixels)",
      "type": "select",
      "options": [
        1,
        2,
        4
      ],
      "default": 1,
      "binding": {
        "node": "145:138",
        "field": "megapixels"
      },
      "alsoBindings": [
        {
          "node": "145:141",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "steps",
      "label": "Steps",
      "type": "integer",
      "min": 4,
      "max": 50,
      "default": 16,
      "binding": {
        "node": "128:107",
        "field": "steps"
      },
      "alsoBindings": [
        {
          "node": "128:130",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "integer",
      "min": 0,
      "max": 2147483647,
      "default": 20261031,
      "binding": {
        "node": "128:107",
        "field": "seed"
      },
      "alsoBindings": [
        {
          "node": "127:111",
          "field": "sampling_mode.seed"
        }
      ]
    },
    {
      "id": "improve_prompt",
      "label": "Improve my prompt",
      "type": "boolean",
      "default": true,
      "binding": {
        "node": "127:116",
        "field": "switch"
      }
    }
  ],
