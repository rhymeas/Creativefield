{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "scene.png"
    },
    "_meta": {
      "title": "Photo of the scene (image)"
    }
  },
  "2": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Its size"
    }
  },
  "3": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(a, b) > 2048",
      "values.a": [
        "2",
        0
      ],
      "values.b": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Longer edge over 2048 px?"
    }
  },
  "4": {
    "class_type": "ResizeImagesByLongerEdge",
    "inputs": {
      "longer_edge": 2048,
      "images": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Longer edge to 2048"
    }
  },
  "5": {
    "class_type": "ComfySwitchNode",
    "inputs": {
      "switch": [
        "3",
        2
      ],
      "on_false": [
        "1",
        0
      ],
      "on_true": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Resized only when needed"
    }
  },
  "6": {
    "class_type": "LoadMoGeModel",
    "inputs": {
      "model_name": "moge_2_vitl_normal_fp16.safetensors"
    },
    "_meta": {
      "title": "MoGe model (checkpoint)"
    }
  },
  "7": {
    "class_type": "MoGeInference",
    "inputs": {
      "resolution_level": 9,
      "fov_x_degrees": 0,
      "batch_size": 4,
      "force_projection": true,
      "apply_mask": true,
      "refine_steps": 3,
      "moge_model": [
        "6",
        0
      ],
      "image": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Point map, depth, camera (resolutionLevel, fovX: 0 = estimate)"
    }
  },
  "8": {
    "class_type": "MoGePointMapToMesh",
    "inputs": {
      "batch_index": 0,
      "decimation": 1,
      "discontinuity_threshold": 0.04,
      "texture": true,
      "moge_geometry": [
        "7",
        0
      ]
    },
    "_meta": {
      "title": "Textured mesh of the whole frame (decimation)"
    }
  },
  "9": {
    "class_type": "SaveGLB",
    "inputs": {
      "filename_prefix": "3d/scene-mesh-moge",
      "mesh": [
        "8",
        0
      ]
    },
    "_meta": {
      "title": "Scene GLB"
    }
  },
  "10": {
    "class_type": "MoGeRender",
    "inputs": {
      "output": "depth",
      "moge_geometry": [
        "7",
        0
      ]
    },
    "_meta": {
      "title": "Depth render"
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "3d/scene-mesh-moge",
      "images": [
        "10",
        0
      ]
    },
    "_meta": {
      "title": "Depth PNG"
    }
  }
}
