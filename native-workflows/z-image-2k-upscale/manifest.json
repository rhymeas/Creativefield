{
  "schemaVersion": 2,
  "id": "z-image-2k-upscale",
  "version": "0.1.0",
  "title": "Upscale to 2K, creative",
  "category": "image",
  "description": "Enlarge a picture to about 2K and let Z-Image Turbo add fresh fine detail: RealESRGAN first, then a light redraw. Raise Detail for more new texture; faces and small objects may change above 0.25.",
  "inputs": [
    {
      "id": "source_image",
      "label": "Picture",
      "type": "image",
      "required": true,
      "binding": {
        "node": "77",
        "field": "image"
      }
    }
  ],
  "outputs": [
    {
      "id": "image",
      "label": "Upscaled picture",
      "type": "image",
      "required": true
    }
  ],
  "controls": [
    {
      "id": "denoise",
      "label": "Detail",
      "type": "number",
      "min": 0.1,
      "max": 0.4,
      "step": 0.05,
      "default": 0.2,
      "binding": {
        "node": "87:69",
        "field": "denoise"
      }
    },
    {
      "id": "prompt",
      "label": "Prompt (optional)",
      "type": "string",
      "default": "masterpiece, 8k",
      "binding": {
        "node": "87:67",
        "field": "text"
      }
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "integer",
      "min": 0,
      "max": 2147483647,
      "default": 20261031,
      "binding": {
        "node": "87:69",
        "field": "seed"
      }
    }
  ],
