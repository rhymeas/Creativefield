{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "SOURCE_REQUIRED.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["1", 0]
    }
  },
  "3": {
    "class_type": "RTXVideoSuperResolution",
    "inputs": {
      "images": ["2", 0],
      "resize_type": "scale by multiplier",
      "resize_type.scale": 2,
      "quality": "ULTRA",
      "strength": 1,
      "image_encoding": "8-bit RGB"
    }
  },
  "4": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["3", 0],
      "fps": ["2", 2],
      "audio": ["2", 1],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    }
  },
  "5": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["4", 0],
      "filename_prefix": "ComfyField/nvidia-vfx-upscale",
      "format": "auto",
      "codec": "auto"
    }
  }
}
