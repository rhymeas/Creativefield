{
  "schemaVersion": 2,
  "id": "lip-sync",
  "version": "0.2.0",
  "title": "Local portrait lip sync",
  "category": "video",
  "description": "Local single-speaker portrait animation driven by a saved microphone take or mono PCM16 WAV. A close-up fictional portrait produced visible speech-related mouth motion with matching audio/video duration on RTX4090. Supported window1\u20133.2seconds; model fidelity varies.",
  "inputs": [
    {
      "id": "start_image",
      "label": "Portrait to animate",
      "type": "image",
      "required": true,
      "binding": {
        "node": "1",
        "field": "image"
      }
    },
    {
      "id": "source_audio",
      "label": "Voice take (mono PCM16 WAV)",
      "type": "audio",
      "required": true,
      "binding": {
        "node": "2",
        "field": "audio"
      }
    }
  ],
  "outputs": [
    {
      "id": "video",
      "label": "Speaking portrait",
      "type": "video",
      "required": true
    }
  ],
  "controls": [
    {
      "id": "prompt",
      "label": "Performance instruction",
      "type": "string",
      "default": "A person speaking naturally to camera, stable portrait and lighting.",
      "binding": {
        "node": "6",
        "field": "text"
      }
    },
    {
      "id": "length",
      "label": "Duration",
      "type": "number",
      "min": 1,
      "max": 3.2,
      "step": 0.1,
      "default": 2,
      "binding": {
        "node": "11",
        "field": "length",
        "transform": "seconds_to_wan_frames"
      }
    },
    {
      "id": "audio_start",
      "label": "Audio start (seconds)",
      "type": "number",
      "min": 0,
      "max": 59,
      "step": 0.1,
      "default": 0,
      "binding": {
        "node": "15",
        "field": "start_index"
      }
    },
    {
      "id": "width",
      "label": "Width",
      "type": "integer",
      "min": 480,
      "max": 832,
      "step": 16,
      "default": 480,
      "binding": {
        "node": "11",
        "field": "width"
      }
    },
    {
      "id": "height",
      "label": "Height",
      "type": "integer",
      "min": 480,
      "max": 832,
      "step": 16,
      "default": 832,
      "binding": {
        "node": "11",
        "field": "height"
      }
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "integer",
      "min": 0,
      "max": 2147483647,
      "default": 20261021,
      "binding": {
        "node": "12",
        "field": "seed"
      }
    },
    {
      "id": "audio_scale",
      "label": "Speech motion strength",
      "type": "number",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "default": 1,
      "binding": {
        "node": "11",
        "field": "audio_scale"
      }
    }
  ],
