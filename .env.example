# Copy this file to .env for npm run server and npm run server:bootstrap. Keep it out of exports.
# The one-command npm start does not read this file: it writes its own .comfyfield/app.env.
# The database the server uses. Create it as UTF-8 first; startup refuses other encodings.
DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:5432/comfyfield
# Where uploaded and generated media goes. Keep it outside the checkout.
STORAGE_ROOT=/path/to/comfyfield-data
# Generate 32 random bytes, base64 encoded. Back up securely; losing this key loses provider credentials.
MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# The exact address you open in the browser. Use 127.0.0.1, not localhost: writes from
# another origin are refused. With npm run dev, use http://127.0.0.1:5173 instead.
PUBLIC_ORIGIN=http://127.0.0.1:8787
# ComfyUI extensions use a separate origin (default PORT+1, normally 8788).
# Keep the same host and protocol as PUBLIC_ORIGIN on a different port. Publish this
# listener through TLS too when the app uses HTTPS; it exposes no ComfyField app API.
# NODE_EDITOR_PORT=8788
# NODE_EDITOR_ORIGIN=http://127.0.0.1:8788
# Bind address and port for npm run server. npm start always serves 127.0.0.1:8787.
HOST=127.0.0.1
PORT=8787
# Largest upload or imported file, in MB. Default 128, at most 2048.
MAX_UPLOAD_MB=128
# Serve the built team UI at this API origin. Run npm run build first.
# When enabled, set PUBLIC_ORIGIN to this server's externally used origin.
SERVE_UI=0
# UI_ROOT=dist
# For a separate team-mode Vite development server: VITE_TEAM_MODE=1
# Local single-user mode (no login wall): the server auto-creates one local
# user/workspace and signs the browser in automatically. Only use on a
# loopback-only, single-user machine. Never enable on a shared deployment.
# LOCAL_SINGLE_USER=1
# AI text with a hosted model (OpenRouter, OpenAI, DeepSeek). Leave these empty
# to write text on the local ComfyUI worker instead. The address is a host or a
# host + /v1; /chat/completions is added. The key is never printed anywhere.
# COMFYFIELD_LLM_URL=https://api.deepseek.com/v1
# COMFYFIELD_LLM_MODEL=deepseek-chat
# COMFYFIELD_LLM_API_KEY=REPLACE_WITH_YOUR_KEY
# Comfy Cloud as a worker. Without this key no Comfy Cloud worker can be added.
# The key is read here only and is never written to the database.
# COMFY_CLOUD_API_KEY=REPLACE_WITH_YOUR_COMFY_CLOUD_KEY
# Or keep the key in a file you own: one line with the key alone, or
# COMFY_CLOUD_API_KEY=the-key. COMFY_CLOUD_API_KEY wins when both are set.
# COMFY_CLOUD_API_KEY_FILE=/path/to/comfy-cloud-key.txt
# Replace character: build a long clip as chained 81-frame passes. Leave this off
# until a real two-pass render has passed the seam check. Off posts one 81-frame pass.
# COMFYFIELD_SCAIL_CHUNKS=1
# First-deployment CLI only; remove these values after bootstrap.
# BOOTSTRAP_EMAIL=admin@example.test
# BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
# BOOTSTRAP_WORKSPACE=My team
# Session and invitation lifetime in hours. Defaults: 168 (7 days) and 72 (3 days).
# SESSION_TTL_HOURS=168
# INVITE_TTL_HOURS=72
# Your ComfyUI models folder. The setup check and the model inventory read it.
# COMFYFIELD_MODEL_ROOT=/path/to/ComfyUI/models
# Only needed when FFmpeg is not on PATH.
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe
# The official Comfy SDK proxy, when you run one (see README: Local SDK profile).
# COMFY_SDK_BASE_URL=http://127.0.0.1:8189
# COMFY_SDK_WORKER_ORIGIN=http://127.0.0.1:8188
# Memory gate: share of system RAM that must stay free before a run (default 0.15,
# 0.02-0.95), and idle minutes before a worker's models unload (default 5, 1-1440).
# COMFYFIELD_MIN_FREE_RAM_SHARE=0.15
# COMFYFIELD_IDLE_UNLOAD_MINUTES=5
