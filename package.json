{
  "name": "creativefield",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "CreativeField: a simple creative studio for ComfyUI workflows, running on your computer",
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "start": "node scripts/start-local.mjs",
    "backup": "node scripts/backup-local.mjs",
    "restore": "node scripts/backup-local.mjs restore",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "tsx scripts/comfy-smoke.ts",
    "smoke:real": "node scripts/real-smoke.mjs",
    "validate:workflows": "tsx scripts/validate-workflows.ts",
    "e2e:real": "node scripts/e2e-real.mjs",
    "e2e:storyboard": "node scripts/storyboard-e2e.mjs",
    "e2e:motion": "node scripts/motion-e2e.mjs",
    "e2e:masked": "node scripts/masked-edit-e2e.mjs",
    "e2e:interpolate": "node scripts/frame-interpolation-e2e.mjs",
    "e2e:all": "node scripts/e2e-all.mjs",
    "render-test": "tsx scripts/render-test.ts",
    "reject-demo": "tsx scripts/reject-demo.ts",
    "server": "node --env-file=.env --import tsx server/main.ts",
    "server:bootstrap": "node --env-file=.env --import tsx server/bootstrap.ts",
    "server:check": "tsc -p tsconfig.server.json",
    "fixture-worker": "tsx server/fixture-worker.ts",
    "worker:fixture": "node --env-file=.comfyfield/app.env scripts/worker-target.mjs fixture",
    "worker:local": "node --env-file=.comfyfield/app.env scripts/worker-target.mjs local",
    "e2e:flux-edit": "node scripts/flux-edit-e2e.mjs",
    "session:log": "node scripts/session-log.mjs",
    "worker:remote": "node scripts/worker-remote.mjs",
    "offload:doc": "node scripts/offload-doc.mjs",
    "status": "node --env-file=.comfyfield/app.env scripts/status.mjs",
    "dist:prune": "node scripts/dist-prune.mjs",
    "audit:assets": "node scripts/asset-refs.mjs",
    "check:all": "node scripts/check-all.mjs",
    "audit:claims": "node scripts/audit-claims.mjs",
    "audit:workers": "node scripts/audit-workers.mjs",
    "audit:workflows": "node scripts/workflow-audit.mjs",
    "audit:removal": "node scripts/audit-removal.mjs",
    "audit:ds": "node scripts/ds-audit.mjs"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^8.3.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "fastify": "^5.12.7",
    "lucide-react": "^0.460.0",
    "opentype.js": "1.3.4",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/opentype.js": "^1.3.8",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
