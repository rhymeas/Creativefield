  "execution": { "route": "native-comfy" },
  "timing": { "frameMapping": "wan_seconds_floor_4n1" },
  "modes": ["image_to_video"],
  "inputs": {
    "prompt":      { "node": "129:93", "field": "text" },
    "negative":    { "node": "129:89", "field": "text" },
    "start_image": { "node": "97",     "field": "image" },
    "width":       { "node": "129:98", "field": "width" },
    "height":      { "node": "129:98", "field": "height" },
    "length":      { "node": "129:161", "field": "value" },
    "seed":        { "node": "129:86", "field": "noise_seed" }
  },
  "outputs": {
    "video": { "node": "108" }
