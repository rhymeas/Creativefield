{
  "id": "wan22-i2v-14b",
  "family": "wan22-14b",
  "label": "Wan 2.2 14B (image to video, quality)",
  "display": {
    "title": "Wan 2.2 Quality",
    "subtitle": "Image to video · 14B · 480p",
    "short": "Wan 2.2 14B I2V",
    "resolution": "480p"
